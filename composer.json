{
    "name": "fremeo/core",
    "description": "core framework for fremeo",
    "license": "MIT",
    "type": "core",
    "keywords": ["fremeo", "fremeo-core", "core"],
    "require": {
        "php": "^8.2",
        "phploader/smarty4life": "^v4.0",
		"phploader/cdata": "^v2.0",
        "symfony/filesystem": "^7.4 || ^8.0",
        "symfony/finder": "^7.4 || ^8.0",
        "intervention/image": "^3.11 || ^4.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "prefer-stable": true,
	"autoload": {
        "psr-4": {
            "fremeo\\core\\": "system/core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "fremeo\\core\\tests\\": "tests/"
        }
    }
}